<file path="src/components/mainPage/mainPage.module.scss">
.mainPageWrapper {
  position: relative;

  width: 100%;
  max-width: 430px;
  height: 100dvh;

  margin: 0 auto;
  overflow: hidden;
}

.mainPage {
  position: relative; 
  width: 100%;
  max-width: 430px;
  min-height: 100dvh;
  margin: 0 auto;
  padding-bottom: 76px;
  overflow: hidden;
  background: #fcfaff;
  color: #202b45;
  font-family: Arial, sans-serif;
  top: 45px;
  
   width: 100%;
  height: 100%;

  overflow-y: auto;
  overflow-x: hidden;

  scrollbar-width: none;

  &::-webkit-scrollbar {
    display: none;
  }

  &__hero {
    position: relative;
    width: 100%;
    height: 207px;
    overflow: hidden;
  }

  &__hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 100px;

    background: linear-gradient(
      to bottom,
      transparent,
      #fcfaff
    );
  }

  &__heroImage {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  // Content

  &__content {
    padding: 10px 13px 0;
  }

  &__intro {
    margin-bottom: 18px;
  }

  &__title {
    margin: 0 0 8px;
    font-size: clamp(23px, 7vw, 27px);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.5px;
    background: linear-gradient(100deg, #8295ff 0%, #d779ce 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  &__description {
    max-width: 100%;
    margin: 0;
    color: #646587;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 500;
  }

  // Chance card

  &__chance {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 55px;
    padding: 9px 13px;
    border: 1px solid #e4d9ff;
    border-radius: 11px;
    background: #fff;
  }

  &__chanceInfo {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  &__chanceLabel {
    color: #77758f;
    font-size: 7px;
    font-weight: 500;
  }

  &__country {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
  }

  &__flag {
    font-size: 24px;
  }

  &__chanceValue {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 35px;
    border: 1px solid #ff6c9c;
    border-radius: 7px;
    color: #ff5c91;
    font-size: 10px;

    strong {
      font-size: 8px;
      font-weight: 600;
    }
  }

  // Separator

  &__separator {
    margin: 12px 0 20px;
    border-top: 2px dashed #e1d9f8;
  }

  // Start button

  &__start {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 36px;
    margin-bottom: 11px;
    border: none;
    border-radius: 7px;
    background: linear-gradient(100deg, #8196ff 0%, #ff69a8 100%);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;

    &:active {
      transform: scale(0.98);
      opacity: 0.85;
    }
  }

  &__startIcon {
    font-size: 14px;
  }

  &__startTitle {
    font-size: 18px;
  }

  // Lives

  &__lives {
    width: calc(100% + 13px);
    overflow: hidden;
  }

  &__sectionTitle {
    margin: 0 0 8px 3px;
    font-size: 20px;
    font-weight: 700;
  }

  &__livesList {
    display: flex;
    gap: 15px;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 4px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  // Bottom navigation
}

// Life card

.lifeCard {
  flex: 0 0 107px;
  min-width: 107px;
  overflow: hidden;

  &__image {
    display: block;
    width: 100%;
    height: 72px;
    object-fit: cover;
    border-radius: 9px;
  }

  &__title {
    margin: 4px 0 2px;
    overflow: hidden;
    color: #202b45;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  &__years {
    display: block;
    color: #77758f;
    font-size: 10px;
  }

  &__description {
    display: -webkit-box;
    margin: 2px 0 0;
    overflow: hidden;
    color: #000000;
    font-size: 10px;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
}
